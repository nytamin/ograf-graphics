{
    "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
    "id": "remote-image",
    "version": "1.0.0",
    "name": "Remote Image",
    "description": "Displays an image loaded from a URL, centered on a transparent background with a soft border and rounded corners.",
    "author": {
        "name": "Johans graphics stash"
    },
    "main": "remote-image.js",
    "supportsRealTime": true,
    "supportsNonRealTime": false,
    "stepCount": 1,
    "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
            "url": {
                "type": "string",
                "title": "Image URL",
                "description": "The full URL of the image to display.",
                "format": "uri"
            },
            "showBackground": {
                "type": "boolean",
                "title": "Show White Background & Border",
                "description": "When off, the frame's white background and border are both hidden, leaving only the image.",
                "default": true
            }
        },
        "required": [
            "url"
        ]
    },
    "renderRequirements": [
        {
            "resolution": {
                "width": {
                    "ideal": 1920
                },
                "height": {
                    "ideal": 1080
                }
            },
            "frameRate": {
                "ideal": 60
            },
            "accessToPublicInternet": {
                "ideal": true,
                "required": true
            }
        }
    ]
}
