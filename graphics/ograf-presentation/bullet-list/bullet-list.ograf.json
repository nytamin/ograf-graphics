{
    "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
    "id": "bullet-list",
    "version": "1.0.0",
    "name": "Bullet List",
    "description": "Displays a bullet-point list on a transparent background with a soft border and rounded corners, each point revealing in a staggered sequence.",
    "author": {
        "name": "Johans graphics stash"
    },
    "main": "bullet-list.js",
    "supportsRealTime": true,
    "supportsNonRealTime": false,
    "stepCount": 1,
    "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
            "items": {
                "type": "array",
                "title": "Bullet Points",
                "default": [],
                "items": {
                    "type": "string"
                }
            },
            "staggerMs": {
                "type": "integer",
                "title": "Stagger Reveal Time (ms)",
                "description": "Delay between each bullet point's reveal animation.",
                "default": 150,
                "minimum": 0,
                "maximum": 2000
            }
        },
        "required": [
            "items"
        ]
    },
    "renderRequirements": [
        {
            "resolution": {
                "width": {
                    "ideal": 1920
                },
                "height": {
                    "ideal": 1080
                }
            },
            "frameRate": {
                "ideal": 60
            },
            "accessToPublicInternet": {
                "ideal": false
            }
        }
    ]
}
