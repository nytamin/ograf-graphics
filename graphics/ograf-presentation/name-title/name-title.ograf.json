{
    "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
    "id": "name-title",
    "version": "1.0.0",
    "name": "Name & Title Corner Tag",
    "description": "Displays a name and title as text in a configurable screen corner, on a transparent background, with a per-letter reveal animation.",
    "author": {
        "name": "Johans graphics stash"
    },
    "main": "name-title.js",
    "supportsRealTime": true,
    "supportsNonRealTime": false,
    "stepCount": 1,
    "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
            "name": {
                "type": "string",
                "title": "Name",
                "default": "Johan Nyman"
            },
            "title": {
                "type": "string",
                "title": "Title",
                "default": "SuperFly.tv"
            },
            "corner": {
                "type": "string",
                "title": "Corner",
                "default": "bottom-left",
                "gddType": "select",
                "enum": [
                    "top-left",
                    "top-right",
                    "bottom-left",
                    "bottom-right"
                ],
                "gddOptions": {
                "labels": {
                    "top-left": "Top left",
                    "top-right": "Top right",
                    "bottom-left": "Bottom left",
                    "bottom-right": "Bottom right"
                }
            }
            },
            "color": {
                "type": "string",
                "title": "Text Color",
                "default": "#ffffff",
                "gddType": "color-rrggbb",
                "pattern": "^#[0-9a-f]{6}$"
            }
        },
        "required": [
            "name"
        ]
    },
    "renderRequirements": [
        {
            "resolution": {
                "width": {
                    "ideal": 1920
                },
                "height": {
                    "ideal": 1080
                }
            },
            "frameRate": {
                "ideal": 60
            },
            "accessToPublicInternet": {
                "ideal": false
            }
        }
    ]
}
