{
    "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
    "id": "remote-iframe",
    "version": "1.0.0",
    "name": "Remote Iframe",
    "description": "Displays a web page loaded from a URL in an iframe, centered on a transparent background with a soft border and rounded corners.",
    "author": {
        "name": "Johans graphics stash"
    },
    "main": "remote-iframe.js",
    "supportsRealTime": true,
    "supportsNonRealTime": false,
    "stepCount": 1,
    "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
            "url": {
                "type": "string",
                "title": "Page URL",
                "description": "The full URL of the web page to display.",
                "format": "uri"
            }
        },
        "required": [
            "url"
        ]
    },
    "renderRequirements": [
        {
            "resolution": {
                "width": {
                    "ideal": 1920
                },
                "height": {
                    "ideal": 1080
                }
            },
            "frameRate": {
                "ideal": 60
            },
            "accessToPublicInternet": {
                "ideal": true,
                "required": true
            }
        }
    ]
}
